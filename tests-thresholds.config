// As tests.config, plus the mpileup/call/filter flags passed the way a
// consuming pipeline passes them: through ext.args, args2 and args3.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'BCFTOOLS_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bcftools:latest'
        cpus      = 1
    }
    withName: BCFTOOLS_CALL {
        ext.args  = '-q 0 -a AD,DP'
        ext.args2 = '--ploidy 1'
        ext.args3 = "-e 'FMT/DP<1 || QUAL<5'"
    }
}

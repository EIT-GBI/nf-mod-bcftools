nextflow_process {

    name "Test BCFTOOLS_CALL"
    script "../main.nf"
    process "BCFTOOLS_CALL"

    def TEST_BAM  = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true)'
    def TEST_BAI  = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai", checkIfExists: true)'
    def TEST_FA   = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/genome.fasta", checkIfExists: true)'
    def TEST_FAI  = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/genome.fasta.fai", checkIfExists: true)'

    // What the called variants actually are, and which flags produced them, is
    // asserted in the vcf/ and csv/ tests: they run BCFTOOLS_CALL in a setup
    // block and then read its output as text. A -Ob BCF is not readable here,
    // and its checksum moves between identical runs because bcftools stamps a
    // Date into the header.

    test("BCFTOOLS_CALL - stub - wiring and output names") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}, ${TEST_BAI}]
                input[1] = [${TEST_FA}, ${TEST_FAI}]
                """
            }
        }

        then {
            assert process.success
            assert process.out.bcf
        }
    }

    test("BCFTOOLS_CALL - no ext.args - calls without filtering") {

        config "../../tests.config"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}, ${TEST_BAI}]
                input[1] = [${TEST_FA}, ${TEST_FAI}]
                """
            }
        }

        then {
            assert process.success
            // a real BCF and a real index, not the empty files a stub leaves
            assert path(process.out.bcf[0][1]).size() > 0
            assert path(process.out.bcf[0][2]).size() > 0
        }
    }

    test("BCFTOOLS_CALL - fails when mpileup fails, even though call and filter succeed") {

        config "../../tests.config"

        when {
            process {
                // A SAM with a corrupt record after 40 good ones. mpileup
                // writes some of its output, then exits 1 on the parse error;
                // call and filter turn it into a valid BCF and exit 0. Without
                // pipefail the task took filter's status and passed with that
                // BCF (EIT-GBI/nf-dnaseq#19). With ten or fewer good records
                // mpileup fails before flushing anything, and call then fails
                // on empty input, so the test would pass without pipefail.
                // mpileup reads the whole file, so it needs no index.
                """
                input[0] = [[id:'test'], file("${moduleTestDir}/data/corrupt_record.sam", checkIfExists: true), []]
                input[1] = [${TEST_FA}, ${TEST_FAI}]
                """
            }
        }

        then {
            assert process.failed
            // by name, so the test cannot pass on a failure of something else,
            // such as the harness itself not compiling
            assert process.trace.failed()*.name == ['BCFTOOLS_CALL (test)']
        }
    }
}

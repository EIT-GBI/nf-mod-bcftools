// Config for the bcftools tests that run the tool for real, rather than
// checking stub wiring.
//
// conf/module.config pins :v0.0.0, which only exists once this module is
// released, so the tests track :latest instead - the same reason the consuming
// pipeline carries a `dev` profile.
//
// The selector covers BCFTOOLS_CALL as well, which the downstream tests run in
// a setup block to produce a real BCF.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'BCFTOOLS_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bcftools:latest'
        cpus      = 1
    }
}

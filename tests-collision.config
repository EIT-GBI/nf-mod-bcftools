// params.calling.min_depth/min_qual plus an -e in ext.args3: bcftools filter
// honours only the last -e and would silently drop one of the two filters, so
// BCFTOOLS_CALL refuses to run.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'BCFTOOLS_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-bcftools:latest'
        cpus      = 1
        ext.args3 = "-e 'QUAL<99'"
    }
}
